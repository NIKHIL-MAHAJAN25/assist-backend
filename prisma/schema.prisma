generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  patient
  family_caregiver
}

enum DeviceType {
  esp32cam
  watch
}

enum LogEntryType {
  frame
  geofence
  heartrate
  quiz
  sighting
}

enum InviteKind {
  caregiver
  device
}

enum AgentDecision {
  log_only
  alert_family
  check_in
}

model Patient {
  id        String   @id @default(uuid())
  name      String
  dob       DateTime
  createdAt DateTime @default(now()) @map("created_at")

  // Emergency (NFC) tag: a short public code printed into the sticker's URL, and what a
  // stranger who taps it is allowed to see.
  tagCode     String? @unique @map("tag_code")
  tagNote     String? @map("tag_note")
  homeLabel   String? @map("home_label")
  tagShowHome Boolean @default(true) @map("tag_show_home")

  users             User[]
  emergencyContacts EmergencyContact[]
  devices       Device[]
  logEntries    LogEntry[]
  enrolledFaces EnrolledFace[]
  geofenceZones GeofenceZone[]
  quizQuestions QuizQuestion[]
  invites       Invite[]

  @@map("patients")
}

model EmergencyContact {
  id        String  @id @default(uuid())
  patientId String  @map("patient_id")
  name      String
  relation  String?
  phone     String
  sortOrder Int     @default(0) @map("sort_order")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  patientId    String   @map("patient_id")
  createdAt    DateTime @default(now()) @map("created_at")

  patient          Patient        @relation(fields: [patientId], references: [id])
  createdZones     GeofenceZone[] @relation("ZoneCreator")
  invitesSent      Invite[]       @relation("InviteCreator")

  @@map("users")
}

model Device {
  id          String     @id @default(uuid())
  patientId   String     @map("patient_id")
  deviceType  DeviceType @map("device_type")
  identifier  String
  apiKeyHash  String     @map("api_key_hash")
  createdAt   DateTime   @default(now()) @map("created_at")

  patient    Patient    @relation(fields: [patientId], references: [id])
  logEntries LogEntry[]

  @@map("devices")
}

model LogEntry {
  id                 String         @id @default(uuid())
  patientId          String         @map("patient_id")
  deviceId           String?        @map("device_id")
  entryType          LogEntryType   @map("entry_type")
  timestamp          DateTime       @default(now())
  payload            Json
  requiresAttention  Boolean        @default(false) @map("requires_attention")
  agentDecision      AgentDecision? @map("agent_decision")
  imagePublicId      String?        @map("image_public_id")
  isSaved            Boolean        @default(false) @map("is_saved")
  acknowledgedAt     DateTime?      @map("acknowledged_at")
  createdAt          DateTime       @default(now()) @map("created_at")

  patient      Patient         @relation(fields: [patientId], references: [id])
  device       Device?         @relation(fields: [deviceId], references: [id])
  faces        LogEntryFace[]
  quizSourceOf QuizQuestion[]

  @@map("log_entries")
}

model EnrolledFace {
  id                  String   @id @default(uuid())
  patientId           String   @map("patient_id")
  name                String
  referenceEmbedding  Json     @map("reference_embedding")
  createdAt           DateTime @default(now()) @map("created_at")

  patient Patient        @relation(fields: [patientId], references: [id])
  logs    LogEntryFace[]

  @@map("enrolled_faces")
}

model LogEntryFace {
  logEntryId     String @map("log_entry_id")
  enrolledFaceId String @map("enrolled_face_id")

  logEntry     LogEntry     @relation(fields: [logEntryId], references: [id])
  enrolledFace EnrolledFace @relation(fields: [enrolledFaceId], references: [id])

  @@id([logEntryId, enrolledFaceId])
  @@map("log_entry_faces")
}

model GeofenceZone {
  id            String   @id @default(uuid())
  patientId     String   @map("patient_id")
  name          String
  centerLat     Float    @map("center_lat")
  centerLng     Float    @map("center_lng")
  radiusMeters  Float    @map("radius_meters")
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id])
  creator User    @relation("ZoneCreator", fields: [createdBy], references: [id])

  @@map("geofence_zones")
}

model QuizQuestion {
  id                String   @id @default(uuid())
  patientId         String   @map("patient_id")
  date              DateTime @default(now())
  question          String
  correctAnswer     String   @map("correct_answer")
  sourceLogEntryId  String?  @map("source_log_entry_id")
  createdAt         DateTime @default(now()) @map("created_at")

  patient        Patient       @relation(fields: [patientId], references: [id])
  sourceLogEntry LogEntry?     @relation(fields: [sourceLogEntryId], references: [id])
  attempts       QuizAttempt[]

  @@map("quiz_questions")
}

model QuizAttempt {
  id              String   @id @default(uuid())
  quizQuestionId  String   @map("quiz_question_id")
  answered        String
  correct         Boolean
  timestamp       DateTime @default(now())

  quizQuestion QuizQuestion @relation(fields: [quizQuestionId], references: [id])

  @@map("quiz_attempts")
}

// A short code a caregiver hands out: `caregiver` lets another family member create an account on
// this patient; `device` pairs the patient's own phone without typing the patient id.
model Invite {
  id        String     @id @default(uuid())
  code      String     @unique
  patientId String     @map("patient_id")
  kind      InviteKind
  createdBy String     @map("created_by")
  createdAt DateTime   @default(now()) @map("created_at")
  expiresAt DateTime   @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  usedBy    String?    @map("used_by")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  creator User    @relation("InviteCreator", fields: [createdBy], references: [id])

  @@map("invites")
}

// Work for the AI helpers (frame analysis, summaries). Helpers on the host claim jobs over the
// internal API; anything not picked up or failed falls back to Gemini inside the backend.
model AiJob {
  id            String    @id @default(uuid())
  kind          String    // frame | summary
  status        String    @default("queued") // queued | running | done | failed | dropped
  patientId     String    @map("patient_id")
  payload       Json
  result        Json?
  error         String?
  attempts      Int       @default(0)
  avoidProvider String?   @map("avoid_provider")
  provider      String?
  workerId      String?   @map("worker_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")

  @@index([status, createdAt])
  @@map("ai_jobs")
}

// Actions the family sends to the patient's phone (from the Assistant tab). The phone polls for
// pending ones, carries them out (e.g. speaks a message aloud) and reports back.
model DeviceCommand {
  id          String    @id @default(uuid())
  patientId   String    @map("patient_id")
  type        String    // speak
  payload     Json
  status      String    @default("pending") // pending | delivered | done | failed | expired
  createdBy   String    @map("created_by")
  senderName  String    @map("sender_name")
  createdAt   DateTime  @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")
  doneAt      DateTime? @map("done_at")
  expiresAt   DateTime  @map("expires_at")
  error       String?

  @@index([patientId, status])
  @@map("device_commands")
}

// "Tell the family": a note one family member sends to everyone in the circle (Assistant action).
// Shows up in every member's notifications (website + family app).
model FamilyBroadcast {
  id         String   @id @default(uuid())
  patientId  String   @map("patient_id")
  fromUserId String   @map("from_user_id")
  senderName String   @map("sender_name")
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([patientId, createdAt])
  @@map("family_broadcasts")
}
