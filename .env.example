# Postgres (local dev — see D:\AssistVault\wiki\tech-stack.md for how this instance was set up)
DATABASE_URL="postgresql://assist_app:assist_dev_pw@localhost:5432/assistdb?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Gemini
GEMINI_API_KEY="replace-with-real-key"
GEMINI_MODEL="gemini-2.5-flash"

# Cloudinary
CLOUDINARY_CLOUD_NAME="replace-with-real-value"
CLOUDINARY_API_KEY="replace-with-real-value"
CLOUDINARY_API_SECRET="replace-with-real-value"

# Twilio (Phase 1+, not needed for Phase 0)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Resend (Phase 1+, not needed for Phase 0)
RESEND_API_KEY=""

# Firebase Cloud Messaging (Phase 1+, not needed for Phase 0)
FCM_SERVER_KEY=""

PORT=3000
